{
  "openapi": "3.0.3",
  "info": {
    "title": "WebLimbAI API",
    "description": "High-performance Web Crawler, Hybrid BM25 + Vector RAG Search Engine, DuckDuckGo Metasearch, DeepSeek Agentic Reasoner, and Model Context Protocol (MCP) API Specification.",
    "version": "1.5.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "LightLimbs Single-Binary Embedded Server"
    },
    {
      "url": "http://localhost:8090",
      "description": "PowerLimbs Agent Microservice (agent-service)"
    },
    {
      "url": "http://localhost:8088",
      "description": "PowerLimbs Search Microservice (search-service)"
    }
  ],
  "security": [
    { "ApiKeyAuth": [] },
    { "BearerAuth": [] }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check Status",
        "description": "Returns system health status, memory stats, and current deployment mode.",
        "responses": {
          "200": { "description": "System Healthy" }
        }
      }
    },
    "/v1/scrape": {
      "post": {
        "summary": "Scrape and Auto-Index Web Page",
        "description": "Fetches target website URL, converts HTML to clean Markdown, and auto-indexes into memory.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": { "type": "string", "example": "https://go.dev" },
                  "mode": { "type": "string", "enum": ["clean_rag", "preserve_links", "raw"], "default": "clean_rag" },
                  "ttl_seconds": { "type": "integer", "example": 86400 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Web Page Successfully Scraped & Indexed" }
        }
      },
      "get": {
        "summary": "Scrape Web Page via Query String",
        "parameters": [
          { "name": "url", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "mode", "in": "query", "schema": { "type": "string", "enum": ["clean_rag", "preserve_links", "raw"] } },
          { "name": "ttl_seconds", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Scrape Response" }
        }
      }
    },
    "/v1/search": {
      "post": {
        "summary": "Hybrid BM25 + Vector RRF Search",
        "description": "Executes Reciprocal Rank Fusion search across the indexed corpus.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": { "type": "string", "example": "goroutine scheduler" },
                  "top_k": { "type": "integer", "default": 5 },
                  "mode": { "type": "string", "enum": ["hybrid", "bm25", "vector"], "default": "hybrid" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Ranked Hybrid Search Hits" }
        }
      },
      "get": {
        "summary": "Hybrid Search via GET",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "top_k", "in": "query", "schema": { "type": "integer", "default": 5 } },
          { "name": "mode", "in": "query", "schema": { "type": "string", "enum": ["hybrid", "bm25", "vector"] } }
        ],
        "responses": {
          "200": { "description": "Search Hits" }
        }
      }
    },
    "/v1/web-search": {
      "post": {
        "summary": "Live DuckDuckGo Metasearch & Instant Ingestion",
        "description": "Queries live web search, crawls target URLs, parses HTML to Markdown, and indexes results on-the-fly.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": { "type": "string", "example": "go 1.23 release notes" },
                  "top_k": { "type": "integer", "default": 5 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Live Web Search Hits" }
        }
      }
    },
    "/v1/agentic-search": {
      "post": {
        "summary": "DeepSeek Agentic AI Reasoning Pipeline",
        "description": "Autonomous multi-step RAG pipeline: Query Decomposition -> Live Web Ingestion -> DeepSeek Reasoning & Answer Synthesis.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": { "type": "string" },
                  "model": { "type": "string", "default": "deepseek-chat" },
                  "llm_api_key": { "type": "string" },
                  "llm_base_url": { "type": "string" },
                  "top_k": { "type": "integer", "default": 5 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Synthesized Answer with Trace Steps & Citations" }
        }
      }
    },
    "/v1/autocomplete": {
      "get": {
        "summary": "In-Memory Trie Prefix Autocomplete",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 5 } }
        ],
        "responses": {
          "200": { "description": "Prefix Autocomplete Suggestions" }
        }
      }
    },
    "/v1/extract": {
      "post": {
        "summary": "Structured JSON Field Extractor",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url", "fields"],
                "properties": {
                  "url": { "type": "string" },
                  "fields": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Extracted Structured Key-Value Pairs" }
        }
      }
    },
    "/v1/agent/query": {
      "post": {
        "summary": "Agent Service Hybrid Query",
        "responses": { "200": { "description": "Hybrid Query Results" } }
      }
    },
    "/v1/agent/tools": {
      "get": {
        "summary": "Expose OpenAI-Compatible Agent Tools",
        "responses": { "200": { "description": "Agent Tools Definitions" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
